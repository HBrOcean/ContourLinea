{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContourLinea",
  "version": "1.1.0",
  "identifier": "com.oceaniat.contourlinea",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ContourLinea",
        "width": 1200,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": true,
      "pubkey": "",
      "endpoints": [
        "https://github.com/HBrOcean/ContourLinea/releases/latest/download/latest.json"
      ]
    }
  }
}
