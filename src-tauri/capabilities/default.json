{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ContourLinea 默认权限：核心能力 + 文件对话框 + 剪贴板 + 更新器",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image",
    "updater:default",
    "process:allow-restart"
  ]
}
